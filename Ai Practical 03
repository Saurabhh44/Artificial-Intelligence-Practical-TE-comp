def win(b):
    lines = [(0,1,2),(3,4,5),(6,7,8),
             (0,3,6),(1,4,7),(2,5,8),
             (0,4,8),(2,4,6)]

    for a,c,d in lines:
        if b[a] != " " and b[a] == b[c] == b[d]:
            return b[a]
    return None


def minimax(b, max_player):
    w = win(b)

    if w == "X": return 1
    if w == "O": return -1
    if " " not in b: return 0

    if max_player:
        best = -999
        for i in range(9):
            if b[i] == " ":
                b[i] = "X"
                best = max(best, minimax(b, False))
                b[i] = " "
        return best

    else:
        best = 999
        for i in range(9):
            if b[i] == " ":
                b[i] = "O"
                best = min(best, minimax(b, True))
                b[i] = " "
        return best


board = ["X","O","X",
         " ","O"," ",
         " "," "," "]

best = -999
move = 0

for i in range(9):
    if board[i] == " ":
        board[i] = "X"
        value = minimax(board, False)
        board[i] = " "

        if value > best:
            best = value
            move = i

print("Best Move:", move)
print("Value:", best)
